PORT=3000

# Base de datos
SQL_SERVER=your_server.database.windows.net
SQL_PORT=1433
SQL_USER=your_db_user
SQL_PASSWORD=your_db_password
SQL_DATABASE=your_db_name

# Auth - JWT
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=cambia_esto_por_OTRO_string_largo_y_aleatorio
JWT_REFRESH_EXPIRES_IN=30d

# Blob Storage (mock | azure)
BLOB_STORAGE_MODE=mock
BLOB_MOCK_BASE_PATH=data/blob-mock
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=retailscope-images
AZURE_GLOBAL_TRAINING_CONTAINER=global-sku-training
BLOB_HIERARCHY_THRESHOLD=500

# Pipeline cognitivo (6.x)
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=retsc-sku-vectors
AZURE_QUEUE_NAME=sku-image-processing

# Custom Vision
CUSTOM_VISION_TRAINING_KEY=
CUSTOM_VISION_PREDICTION_KEY=
CUSTOM_VISION_ENDPOINT=
CUSTOM_VISION_PREDICTION_RESOURCE_ID=

# Email SMTP (dejar SMTP_HOST vacio para modo mock)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@retailscope.com
