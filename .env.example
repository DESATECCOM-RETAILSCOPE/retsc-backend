PORT=3000

# Azure SQL Server
SQL_SERVER=your_server.database.windows.net
SQL_PORT=1433
SQL_USER=your_db_user
SQL_PASSWORD=your_db_password
SQL_DATABASE=your_db_name

# Auth
# JWT - Access token (corto, viaja en cada request)
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# JWT - Refresh token (largo, solo para renovar access)
JWT_REFRESH_SECRET=cambia_esto_por_OTRO_string_largo_y_aleatorio_distinto_al_anterior
JWT_REFRESH_EXPIRES_IN=30d

# Blob Storage — BLOB_STORAGE_MODE: mock | azure
BLOB_STORAGE_MODE=mock
BLOB_MOCK_BASE_PATH=data/blob-mock
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=retailscope-images

# Blob Storage — container global de entrenamiento de IA
# El container 'global-sku-training' debe existir previamente en Azure Storage.
# En modo mock, se simula en data/blob-mock/global-sku-training/
AZURE_GLOBAL_TRAINING_CONTAINER=global-sku-training

# Pipeline
BLOB_HIERARCHY_THRESHOLD=500

# Azure Custom Vision — API de entrenamiento de modelos de visión artificial
# Dejar vacíos hasta que las credenciales sean entregadas por el equipo de infraestructura.
# El código está preparado: si están vacíos, el provisioning de Custom Vision se saltea
# y los modelos quedan en estado PENDING hasta que se configure manualmente.
# SDK a instalar cuando lleguen las keys: @azure/cognitiveservices-customvision-training
# TODO: instalar SDK y completar customVisionService.js cuando lleguen las credenciales
CUSTOM_VISION_TRAINING_KEY=
CUSTOM_VISION_PREDICTION_KEY=
CUSTOM_VISION_ENDPOINT=
CUSTOM_VISION_PREDICTION_RESOURCE_ID=

# Email (SMTP) — dejar vacío para modo mock (imprime en consola)
# Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
# Outlook: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@retailscope.com
