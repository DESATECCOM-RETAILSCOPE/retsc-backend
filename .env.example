PORT=3000

# Base de datos
SQL_SERVER=your_server.database.windows.net
SQL_PORT=1433
SQL_USER=your_db_user
SQL_PASSWORD=your_db_password
SQL_DATABASE=your_db_name

# Auth - JWT
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=cambia_esto_por_OTRO_string_largo_y_aleatorio
JWT_REFRESH_EXPIRES_IN=30d

# Blob Storage (mock | azure)
BLOB_STORAGE_MODE=mock
BLOB_MOCK_BASE_PATH=data/blob-mock
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=retailscope-images
AZURE_GLOBAL_TRAINING_CONTAINER=global-sku-training
BLOB_HIERARCHY_THRESHOLD=500

# Revisión de anotaciones (Issue 7.5)
# Roles (Role_name en RETSC_OP_ROLES) que pueden aprobar/corregir/rechazar anotaciones.
# CSV, sensible a mayúsculas. El issue pedía ANOTADOR_SENIOR (no existe en la BD);
# se mapea a Supervisor. Admin siempre debería estar incluido.
ANNOTATION_VALIDATOR_ROLES=Admin,Supervisor

# Versioning y re-entrenamiento de modelos (Issue 8.5)
# Roles que pueden gestionar versiones (retrain, approve, rollback). CSV.
MODEL_MANAGER_ROLES=Admin
# Mínimo de fotos nuevas (con anotación validada) para permitir re-entrenar.
MODEL_RETRAIN_MIN_PHOTOS=20
# Margen de tolerancia de mAP: la versión nueva se considera "peor" (requiere
# aprobación manual) si su mean_ap < mean_ap_activo - MODEL_METRIC_TOLERANCE.
MODEL_METRIC_TOLERANCE=0

# Validación de calidad de fotos de góndola (Issue 7.1)
# Solo fotos que cumplen los 4 criterios entran al dataset de entrenamiento.
# Resolución mínima (px)
QUALITY_MIN_WIDTH=1280
QUALITY_MIN_HEIGHT=720
# Nitidez: score normalizado [0,1]; la foto pasa si es MAYOR a este umbral.
# NOTA: los JPEGs de fotos reales tienen varianza de Laplaciano mucho menor que imágenes
# sintéticas (~5-100 vs ~2900). Con NORM=100 y MIN=0.005: blur fuerte falla, fotos
# de cámara normales pasan. CALIBRAR con fotos reales de góndola cuando haya volumen.
QUALITY_MIN_SHARPNESS=0.005
# Divisor para normalizar la varianza del Laplaciano a [0,1]. Ajustar junto a MIN_SHARPNESS.
QUALITY_SHARPNESS_NORM=100
# Iluminación: brillo medio aceptado (escala 0-255)
QUALITY_MIN_BRIGHTNESS=30
QUALITY_MAX_BRIGHTNESS=220

# Pipeline cognitivo SKU (Issue 6.x) — OCR, embeddings y cola de procesamiento
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=retsc-sku-vectors
AZURE_QUEUE_NAME=sku-image-processing

# Azure Custom Vision — API de entrenamiento de modelos de visión artificial
# Dejar vacíos hasta que las credenciales sean entregadas por el equipo de infraestructura.
# El código está preparado: si están vacíos, el provisioning de Custom Vision se saltea
# y los modelos quedan en estado PENDING hasta que se configure manualmente.
# SDK a instalar cuando lleguen las keys: @azure/cognitiveservices-customvision-training
# TODO: instalar SDK y completar customVisionService.js cuando lleguen las credenciales
CUSTOM_VISION_TRAINING_KEY=
CUSTOM_VISION_PREDICTION_KEY=
CUSTOM_VISION_ENDPOINT=
CUSTOM_VISION_PREDICTION_RESOURCE_ID=

# Fotos de góndola globales para entrenamiento de detección (Issue 7.2)
# Container de Azure Blob donde se guardan las fotos de góndola globales.
AZURE_GLOBAL_SHELF_CONTAINER=global-shelf-training
# Umbral de fotos validadas+aprobadas por canal para marcar el modelo como IMAGES_UPLOADED.
SHELF_TRAINING_THRESHOLD=15
# Roles que pueden subir fotos de góndola globales. CSV, sensible a mayúsculas.
SHELF_UPLOAD_ROLES=Admin
# Confianza mínima del caption de Azure AI Vision para aceptar la foto (Etapa 2b).
QUALITY_CAPTION_MIN_CONFIDENCE=0.6
# Tags de Custom Vision por canal (Issue #35). Dejar vacíos hasta configurar los tags en el proyecto.
CV_TAG_OMT=
CV_TAG_DTT=
CV_TAG_CONVENIENCE=

# Email SMTP (dejar SMTP_HOST vacio para modo mock)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@retailscope.com
